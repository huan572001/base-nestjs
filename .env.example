NODE_ENV=development

APP_PORT=5002
GLOBAL_PREFIX=api

#SWAGGER
SWAGGER_PATH=/docs
SWAGGER_IS_PUBLIC=true
SWAGGER_HOST=http://localhost:5002
SWAGGER_VERSION=1.0.0
SWAGGER_TITLE='Document API'
SWAGGER_DESC='Document API for dev'

API_KEY=123456

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=snaxfi
MAX_QUERY_EXECUTION_TIME=20000

#redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=snaxfi-local

# Log
LOG_COLOR=true
LOG_LEVEL=info

BASIC_AUTH_PASSWORD=123456

SENTRY_DSN=
SENTRY_DSN_IS_ENABLE=false

APTOS_INDEXER_URL=https://api.mainnet.aptoslabs.com/v1/graphql
APTOS_NETWORK=testnet
APTOS_API_KEY=xxx

SNAXFI_SC_ADDRESS=0xcafe

JWT_ACCESS_SECRET_KEY=xxx
JWT_REFRESH_SECRET_KEY=xxx

HYPERION_INDEXER_URL=https://api.hyperion.xyz/v1/graphql
HYPERION_SC_ADDRESS=0xcafe

PRICE_SERVER_URL=http://localhost:5000
PRICE_SERVER_API_KEY=1

SNAXFI_TICKET_VERIFIER_PK=

SOCIAL_URL=http://[::1]:5001
SOCIAL_API_KEY=123
TIME_INTERVAL=