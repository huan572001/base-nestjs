NODE_ENV=development

APP_PORT=5003
GLOBAL_PREFIX=api

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=flip_vault
MAX_QUERY_EXECUTION_TIME=20000

#redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=flip-vault-local

# Log
LOG_COLOR=true
LOG_LEVEL=info

BASIC_AUTH_PASSWORD=123456

SENTRY_DSN=
SENTRY_DSN_IS_ENABLE=false

TRADEPORT_URL=https://api.indexer.xyz/graphql
TRADEPORT_API_USER=explorer.indexer.xyz
TRADEPORT_API_KEY=

APTOS_INDEXER_URL=https://api.testnet.staging.aptoslabs.com/v1/graphql
APTOS_NETWORK=testnet

SNAX_FI_SC_ADDRESS=0x1aa3af5a019da573e9abbb92c0a997b622858d6f84984200a7797806f72fad9a

KAFKA_ENV=develop
KAFKA_CLIENT_ID=flip-vault-local-client
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCER_ONLY_MODE=false
KAFKA_CONSUMER_GROUP_ID=flip-vault-local-consumer
KAFKA_CONSUMER_FROM_BEGINNING=true

PRICE_SERVER_URL=http://localhost:5000
PRICE_SERVER_API_KEY=1