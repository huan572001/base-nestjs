{
  "name": "snaxfi",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:dev-api": "DOTENV_CONFIG_PATH=apps/api-service/.env nest start api-service --watch --webpackPath webpack.config",
    "start:dev-worker": "DOTENV_CONFIG_PATH=apps/worker/.env nest start worker --watch --webpackPath webpack.config",
    "start:prod-api": "node --no-node-snapshot dist/apps/api-service/main",
    "start:prod-worker": "node --no-node-snapshot dist/apps/worker/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-service/test/jest-e2e.json",
    "postinstall": "husky install",
    "typeorm": "env-cmd ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:prod": "env-cmd ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=./typeorm/data-source.ts migration:generate ./typeorm/migrations/migrations",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- --dataSource=./typeorm/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- --dataSource=typeorm/data-source.ts migration:revert",
    "ts-console": "ts-node --project tsconfig.build.json -r tsconfig-paths/register src/console.ts",
    "console": "node dist/console.js"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run format",
      "git add ."
    ]
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "4.0.0",
    "@bull-board/api": "^5.9.1",
    "@bull-board/express": "^5.9.1",
    "@google-cloud/storage": "^7.16.0",
    "@nestjs/axios": "3.0.0",
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "10.2.6",
    "@nestjs/event-emitter": "2.0.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "10.2.6",
    "@nestjs/passport": "10.0.2",
    "@nestjs/platform-express": "10.2.6",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/terminus": "10.1.1",
    "@nestjs/testing": "^10.0.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^11.0.11",
    "@ntegral/nestjs-sentry": "^4.0.0",
    "@sentry/node": "^7.77.0",
    "@sentry/profiling-node": "^1.2.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.12",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "bignumber.js": "^9.3.0",
    "bull": "^4.11.4",
    "cache-manager": "5.2.3",
    "cache-manager-redis-store": "3.0.1",
    "camelcase-keys": "6.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.0",
    "env-cmd": "^10.1.0",
    "express-basic-auth": "^1.2.1",
    "google-auth-library": "^9.15.1",
    "got": "11",
    "joi": "17.11.0",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "lodash": "4.17.21",
    "log4js": "6.9.1",
    "morgan": "1.10.0",
    "nanoid": "3.3.1",
    "nestjs-cls": "^3.6.0",
    "nestjs-console": "^9.0.0",
    "nestjs-typeorm-paginate": "^4.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "0.1.13",
    "remove": "0.1.5",
    "resend": "^4.2.0",
    "rimraf": "5.0.5",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.1",
    "supertest": "^6.3.3",
    "swagger-ui-express": "5.0.0",
    "typeorm": "^0.3.17",
    "typeorm-cursor-pagination": "^0.10.1",
    "webpack": "5.88.2"
  },
  "devDependencies": {
    "@commitlint/cli": "17.7.2",
    "@commitlint/config-conventional": "17.7.0",
    "@nestjs/cli": "10.1.18",
    "@nestjs/schematics": "10.0.2",
    "@nestjs/swagger": "^7.3.0",
    "@types/cache-manager": "4.0.3",
    "@types/express": "4.17.18",
    "@types/jest": "29.5.5",
    "@types/lodash": "4.14.199",
    "@types/multer": "1.4.8",
    "@types/node": "20.8.2",
    "@types/source-map-support": "^0.5.10",
    "@typescript-eslint/eslint-plugin": "6.7.4",
    "@typescript-eslint/parser": "6.7.4",
    "eslint": "8.50.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-prettier": "5.0.0",
    "husky": "8.0.3",
    "jest": "29.7.0",
    "lint-staged": "14.0.1",
    "prettier": "3.0.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "29.1.1",
    "ts-loader": "9.4.4",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.2.2"
  },
  "roots": [
    "<rootDir>/apps/",
    "<rootDir>/libs/"
  ],
  "moduleNameMapper": {
    "^@libs/infra(|/.*)$": "<rootDir>/libs/infra/src/$1",
    "^@libs/constants(|/.*)$": "<rootDir>/libs/constants/src/$1"
  }
}
