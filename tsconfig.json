{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@api/*": ["apps/api-service/src/*"],
      "@libs/infra": ["libs/infra/src"],
      "@libs/infra/*": ["libs/infra/src/*"],
      "@libs/constants": ["libs/constants/src"],
      "@libs/constants/*": ["libs/constants/src/*"],
      "@libs/common": ["libs/common/src"],
      "@libs/common/*": ["libs/common/src/*"],
      "@lib/service": ["libs/service/src"],
      "@lib/service/*": ["libs/service/src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "apps/**/*", "libs/**/*", "typeorm/**/*"],
  "exclude": ["node_modules", "dist"]
}
